{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikejmckinney/ai-repo-template/.github/schemas/postmerge-retro.schema.json",
  "title": "Post-merge retrospective output",
  "type": "object",
  "required": ["pr", "summary", "follow_up_issues", "adr_updates", "context_pack_updates"],
  "additionalProperties": true,
  "properties": {
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string"
    },
    "follow_up_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/followUpIssue" }
    },
    "adr_updates": {
      "type": "array",
      "items": { "$ref": "#/$defs/adrUpdate" }
    },
    "context_pack_updates": {
      "type": "array",
      "items": { "$ref": "#/$defs/contextPackUpdate" }
    }
  },
  "$defs": {
    "followUpIssue": {
      "type": "object",
      "required": ["title", "body", "dedupe_key"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dedupe_key": { "type": "string", "minLength": 1 }
      }
    },
    "adrUpdate": {
      "type": "object",
      "required": ["title", "body", "dedupe_key"],
      "additionalProperties": true,
      "properties": {
        "adr": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "dedupe_key": { "type": "string", "minLength": 1 }
      }
    },
    "contextPackUpdate": {
      "type": "object",
      "required": ["pack", "reason", "dedupe_key"],
      "additionalProperties": true,
      "properties": {
        "pack": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "add": {
          "type": "array",
          "items": { "type": "string" }
        },
        "remove": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dedupe_key": { "type": "string", "minLength": 1 }
      }
    }
  }
}
