{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikejmckinney/ai-repo-template/.github/schemas/postmerge-retro.schema.json",
  "title": "Post-merge retrospective output",
  "type": "object",
  "required": ["pr", "summary", "evidence_complete", "follow_up_issues"],
  "additionalProperties": true,
  "properties": {
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string"
    },
    "evidence_complete": {
      "const": true,
      "description": "True only after every required full-evidence source has been read."
    },
    "follow_up_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/followUpIssue" }
    },
    "adr_updates": false,
    "context_pack_updates": false
  },
  "$defs": {
    "triageFields": {
      "type": "object",
      "required": ["impact", "trigger_likelihood", "fix_cost"],
      "properties": {
        "impact": {
          "type": "string",
          "enum": ["incorrect-behavior", "dx-perf-doc", "meta-harness"]
        },
        "trigger_likelihood": {
          "type": "string",
          "enum": ["common", "edge", "fringe"]
        },
        "fix_cost": {
          "type": "string",
          "enum": ["trivial", "moderate", "large"]
        },
        "regression_guard": {
          "type": "boolean"
        },
        "priority_band": {
          "type": "string",
          "enum": ["fix-now", "should-fix", "defer"],
          "description": "Derived by automation at validate/merge time; LLM must not emit."
        }
      }
    },
    "followUpIssue": {
      "type": "object",
      "required": [
        "title",
        "body",
        "dedupe_key",
        "repro_steps",
        "impact",
        "trigger_likelihood",
        "fix_cost"
      ],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repro_steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dedupe_key": { "type": "string", "minLength": 1 },
        "impact": { "$ref": "#/$defs/triageFields/properties/impact" },
        "trigger_likelihood": { "$ref": "#/$defs/triageFields/properties/trigger_likelihood" },
        "fix_cost": { "$ref": "#/$defs/triageFields/properties/fix_cost" },
        "regression_guard": { "$ref": "#/$defs/triageFields/properties/regression_guard" },
        "priority_band": { "$ref": "#/$defs/triageFields/properties/priority_band" }
      },
      "not": {
        "required": ["severity"]
      }
    }
  }
}
