{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekly repository review output",
  "type": "object",
  "required": ["summary", "follow_up_issues"],
  "additionalProperties": true,
  "properties": {
    "summary": { "type": "string" },
    "follow_up_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "body",
          "dedupe_key",
          "repro_steps",
          "evidence",
          "impact",
          "trigger_likelihood",
          "fix_cost"
        ],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "dedupe_key": { "type": "string", "minLength": 1 },
          "repro_steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![~/\\\\])(?![A-Za-z]:[/\\\\])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*\\\\).+$"
            }
          },
          "impact": {
            "type": "string",
            "enum": ["incorrect-behavior", "dx-perf-doc", "meta-harness"]
          },
          "trigger_likelihood": {
            "type": "string",
            "enum": ["common", "edge", "fringe"]
          },
          "fix_cost": {
            "type": "string",
            "enum": ["trivial", "moderate", "large"]
          },
          "regression_guard": { "type": "boolean" }
        },
        "not": {
          "anyOf": [
            { "required": ["severity"] },
            { "required": ["priority_band"] }
          ]
        }
      }
    },
    "adr_updates": false,
    "context_pack_updates": false
  }
}
