{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekly repository review output",
  "type": "object",
  "required": ["summary", "follow_up_issues"],
  "additionalProperties": true,
  "properties": {
    "summary": { "type": "string" },
    "follow_up_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "body",
          "dedupe_key",
          "repro_steps",
          "evidence",
          "triage_version",
          "impact",
          "impact_magnitude",
          "trigger_likelihood",
          "affected_scope",
          "reversibility",
          "fix_cost",
          "confidence",
          "uncertainty"
        ],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "dedupe_key": { "type": "string", "minLength": 1 },
          "repro_steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "verification_capability": { "$ref": "#/$defs/verificationCapability" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![~/\\\\])(?![A-Za-z]:[/\\\\])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*\\\\).+$"
            }
          },
          "impact": {
            "type": "string",
            "enum": ["incorrect-behavior", "dx-perf-doc", "meta-harness"]
          },
          "triage_version": { "const": 2 },
          "impact_magnitude": {
            "type": "string",
            "enum": ["bounded", "material", "critical"]
          },
          "trigger_likelihood": {
            "type": "string",
            "enum": ["common", "edge", "fringe"]
          },
          "affected_scope": {
            "type": "string",
            "enum": ["isolated", "limited", "broad"]
          },
          "reversibility": {
            "type": "string",
            "enum": ["easy", "moderate", "hard"]
          },
          "fix_cost": {
            "type": "string",
            "enum": ["trivial", "moderate", "large"]
          },
          "regression_guard": { "type": "boolean" },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "uncertainty": { "type": "string", "minLength": 1 }
        },
        "not": {
          "anyOf": [
            { "required": ["severity"] },
            { "required": ["priority_band"] }
          ]
        }
      }
    },
    "adr_updates": false,
    "context_pack_updates": false
  },
  "$defs": {
    "verificationCapability": {
      "type": "object",
      "required": ["environment", "harness_id", "reason"],
      "additionalProperties": false,
      "properties": {
        "environment": {
          "enum": ["isolated-worktree", "codespaces", "external-state", "unsupported-runtime"]
        },
        "harness_id": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "environment": { "const": "isolated-worktree" } } },
          "then": { "properties": { "harness_id": { "const": "repository-test-suite" } } },
          "else": { "properties": { "harness_id": { "type": "null" } } }
        }
      ]
    }
  }
}
