{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-sol",
  "permission": "allow",
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT}"
      }
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref={env:SUPABASE_PROJECT_REF}",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_API_KEY}"
      }
    },
    "netlify": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec npx -y mcp-remote@0.1.38 https://netlify-mcp.netlify.app/mcp --header \"Authorization:Bearer $NETLIFY_API_KEY\" --transport http-only --silent"
      ],
      "enabled": true,
      "env": {
        "NETLIFY_API_KEY": "{env:NETLIFY_API_KEY}"
      }
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:VERCEL_API_KEY}"
      }
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": true,
      "env": {
        "RAILWAY_API_TOKEN": "{env:RAILWAY_API_KEY}"
      }
    },
    "open-design": {
      "type": "local",
      "command": ["bash", "scripts/open-design-mcp.sh"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": true
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "moonshotai/kimi-k3": {},
        "deepseek/deepseek-v4-pro@preset/default": {},
        "minimax/minimax-m3@preset/default": {},
        "z-ai/glm-5.2@preset/default": {},
        "xiaomi/mimo-v2.5-pro@preset/default": {},
        "openrouter/auto@preset/default": {}
      }
    }
  }
}
