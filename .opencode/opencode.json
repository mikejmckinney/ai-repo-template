{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-sol",
  "permission": "allow",
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT}"
      }
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_API_KEY}"
      }
    },
    "netlify": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "mcp-remote@0.1.38",
        "https://netlify-mcp.netlify.app/mcp",
        "--header",
        "Authorization:Bearer ${NETLIFY_API_KEY}",
        "--transport",
        "http-only",
        "--silent"
      ],
      "timeout": 60000,
      "environment": {
        "NETLIFY_API_KEY": "{env:NETLIFY_API_KEY}"
      }
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:VERCEL_API_KEY}"
      }
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CLOUDFLARE_API_KEY}"
      }
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "railway": {
      "type": "remote",
      "url": "https://mcp.railway.com",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:RAILWAY_API_KEY}"
      }
    },
    "aws": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec uvx mcp-proxy-for-aws@1.6.3 \"https://aws-mcp.${AWS_REGION:-us-east-1}.api.aws/mcp\" --profile \"${AWS_PROFILE:-default}\" --region \"${AWS_REGION:-us-east-1}\""
      ],
      "enabled": true
    },
    "azure": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure/mcp@2.0.5",
        "server",
        "start"
      ],
      "enabled": true
    },
    "oci": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.13",
        "oracle.oci-cloud-mcp-server@2.1.0"
      ],
      "enabled": false,
      "env": {
        "OCI_CONFIG_PROFILE": "{env:OCI_CONFIG_PROFILE}",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "render": {
      "type": "remote",
      "url": "https://mcp.render.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:RENDER_API_KEY}"
      }
    },
    "open-design": {
      "type": "local",
      "command": [
        "bash",
        "scripts/open-design-mcp.sh"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "moonshotai/kimi-k3@preset/consensus": {},
        "deepseek/deepseek-v4-pro@preset/default": {},
        "minimax/minimax-m3@preset/default": {},
        "z-ai/glm-5.2@preset/default": {},
        "xiaomi/mimo-v2.5-pro@preset/default": {},
        "openrouter/auto@preset/default": {}
      }
    }
  }
}
