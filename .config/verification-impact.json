{
  "version": 1,
  "fullPatterns": [
    ".github/workflows/ci-tests.yml",
    "scripts/lib/**",
    "scripts/install-codespace-tools.sh",
    "scripts/verify-env.sh",
    "test.sh"
  ],
  "mappings": [
    {
      "patterns": ["scripts/setup/40-ensure-labels.sh"],
      "bats": ["scripts/tests/active-labels.bats", "scripts/tests/check-labels.bats"],
      "checks": [
        "scripts/checks/126-adr025-invariants.sh"
      ]
    },
    {
      "patterns": [".config/mcp-inventory.json"],
      "bats": ["scripts/tests/generated-mcp-configs.bats", "scripts/tests/provider-integrations.bats"],
      "checks": ["scripts/checks/056-generated-governance-surfaces.sh"],
      "evidence": {
        "scripts/checks/056-generated-governance-surfaces.sh": "scripts/generate-mcp-configs.py"
      }
    },
    {
      "patterns": ["docs/guides/outcome-validation.md"],
      "bats": ["scripts/tests/outcome-evidence-contract.bats"],
      "checks": ["scripts/checks/010-required-files.sh", "scripts/checks/130-adr016-invariants.sh"]
    }
  ]
}
