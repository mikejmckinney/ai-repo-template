{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ai-repo:schemas:backlog",
  "title": "Backlog (.context/backlog.yaml)",
  "description": "Schema for the optional machine-readable project task backlog.",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "entries": {
      "type": "array",
      "description": "Ordered list of project backlog entries.",
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable, unique identifier for this entry.",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Issue title.",
          "minLength": 1,
          "maxLength": 256
        },
        "phase": {
          "type": "integer",
          "description": "Phase number from .context/roadmap.md.",
          "minimum": 0
        },
        "labels": {
          "type": "array",
          "description": "Suggested labels if this entry is later promoted to an issue.",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "description": "Entry ids this entry depends on.",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "body": {
          "type": "string",
          "description": "Task context suitable for promotion to an issue."
        },
        "acceptance_criteria": {
          "type": "array",
          "description": "Acceptance criteria for the task.",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
