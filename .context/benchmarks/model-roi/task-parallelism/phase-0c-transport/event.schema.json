{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-parallelism-phase-0c-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "sequence", "task_id", "kind", "payload", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "task-parallelism-phase-0c-event.v1"},
    "event_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 64},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "kind": {"enum": ["task-assigned", "task-status", "artifact-published", "task-reclassified", "task-failed"]},
    "payload": {"type": "object"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
