{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikejmckinney/ai-repo-template/schemas/task-parallelism-phase-0b-revision-candidate-result.v1.json",
  "title": "Task parallelism Phase 0B revision candidate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "run_id", "attempt_id", "arm",
    "terminal_status", "failure_class", "failure_reason", "base_sha",
    "candidate_sha", "candidate_branch", "produced_work", "changed_files",
    "quality_score", "wall_clock_seconds", "wall_clock_comparable", "tokens", "skill_loads",
    "skill_context_tokens", "coordination_seconds", "provider_wait_seconds",
    "rescue_events", "duplicate_or_abandoned_work", "predicted_path_drift_count",
    "semantic_conflicts", "interface_conflicts", "asset_conflicts",
    "dependency_conflicts", "fanout_elected", "worker_count",
    "candidate_report_path", "evaluator_result_path", "replacement_eligible",
    "replacement_disposition", "official_pilot_score_modified"
  ],
  "properties": {
    "schema_version": { "const": "task-parallelism-phase-0b-revision-candidate-result.v1" },
    "campaign_id": { "const": "vector-siege-phase-0b-revision" },
    "run_id": { "enum": ["vs-p0b-next-a", "vs-p0b-next-b", "vs-p0b-next-c"] },
    "attempt_id": { "type": "string", "pattern": "^vs-p0b-next-[abc]-attempt-[12]$" },
    "arm": { "enum": ["A", "B", "C"] },
    "terminal_status": { "enum": ["completed", "candidate-failed", "provider-failed", "harness-failed"] },
    "failure_class": { "type": ["string", "null"] },
    "failure_reason": { "type": ["string", "null"] },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_branch": { "type": "string" },
    "produced_work": { "type": "boolean" },
    "changed_files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "quality_score": { "type": "number", "minimum": 0 },
    "wall_clock_seconds": { "type": "integer", "minimum": 0 },
    "wall_clock_comparable": { "type": "boolean" },
    "tokens": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "cached_input", "output"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "cached_input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 }
      }
    },
    "skill_loads": { "type": "integer", "minimum": 0 },
    "skill_context_tokens": { "type": "integer", "minimum": 0 },
    "coordination_seconds": { "type": "integer", "minimum": 0 },
    "provider_wait_seconds": { "type": "integer", "minimum": 0 },
    "rescue_events": { "type": "integer", "minimum": 0 },
    "duplicate_or_abandoned_work": { "type": "integer", "minimum": 0 },
    "predicted_path_drift_count": { "type": "integer", "minimum": 0 },
    "semantic_conflicts": { "type": "integer", "minimum": 0 },
    "interface_conflicts": { "type": "integer", "minimum": 0 },
    "asset_conflicts": { "type": "integer", "minimum": 0 },
    "dependency_conflicts": { "type": "integer", "minimum": 0 },
    "fanout_elected": { "type": "boolean" },
    "worker_count": { "type": "integer", "minimum": 1 },
    "candidate_report_path": { "type": ["string", "null"] },
    "evaluator_result_path": { "type": ["string", "null"] },
    "replacement_eligible": { "type": "boolean" },
    "replacement_disposition": { "enum": ["not-eligible", "eligible", "replacement-consumed"] },
    "official_pilot_score_modified": { "const": false }
  }
}
