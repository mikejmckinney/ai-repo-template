{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "benchmark-grade-set.v1",
  "type": "object",
  "required": [
    "schema_version",
    "score_set_id",
    "task_id",
    "stage",
    "rubric_id",
    "grader_prompt_id",
    "bundle_seed",
    "eval_count",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "benchmark-grade-set.v1" },
    "score_set_id": { "type": "string" },
    "task_id": { "type": "string" },
    "stage": { "type": "string" },
    "run_group": { "type": ["string", "null"] },
    "run_index_filter": { "type": ["integer", "null"] },
    "rubric_id": { "const": "rubric.v1" },
    "grader_prompt_id": { "const": "model-roi-grader-v1" },
    "bundle_seed": { "type": "string" },
    "eval_count": { "type": "integer", "minimum": 0 },
    "context_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["context_condition", "context_variant"],
        "properties": {
          "context_condition": { "type": "string" },
          "context_variant": { "type": "string" },
          "context_pack_id": { "type": ["string", "null"] }
        }
      }
    },
    "created_at": { "type": "string" }
  }
}
