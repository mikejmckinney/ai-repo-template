{
  "schema_version": "benchmark-task-grading-spec.v1",
  "task_id": "opfit-326-class-b-premerge-pipeline",
  "task_class": "B-reasoning",
  "rubric_id": "rubric.pipeline.v1",
  "hard_gate": {
    "require_work_produced": true,
    "zero_score_on_fail": true
  },
  "required_paths": [
    "scripts/pr-resolve-all-poll.sh",
    "scripts/lib/bot-allowlist.txt",
    ".github/prompts/pr-resolve-all.md",
    "AI_REPO_GUIDE.md"
  ],
  "forbidden_path_patterns": [
    "^\\.context/sessions/"
  ],
  "scope_penalties": {
    "plan_md_points": 3,
    "context_state_points": 4,
    "agents_md_points": 4,
    "compliance_fixture_points": 3
  },
  "doc_companion_paths": [
    "AI_REPO_GUIDE.md",
    ".github/prompts/pr-resolve-all.md"
  ],
  "acceptance_commands": [
    {
      "id": "bash_n_poll_helper",
      "cmd": "bash -n scripts/pr-resolve-all-poll.sh",
      "enabled": true,
      "category": "quality",
      "max_points": 3,
      "apply_from_diff": true,
      "requires_path": "scripts/pr-resolve-all-poll.sh"
    },
    {
      "id": "lint_poll_helper",
      "cmd": "bash scripts/lint-shell-conventions.sh scripts/pr-resolve-all-poll.sh",
      "enabled": true,
      "category": "quality",
      "max_points": 2,
      "apply_from_diff": true,
      "requires_path": "scripts/pr-resolve-all-poll.sh"
    },
    {
      "id": "bats_poll_helper",
      "cmd": "bats --tap scripts/tests/pr-resolve-all-poll.bats",
      "enabled": false,
      "category": "reliability",
      "max_points": 5,
      "note": "Enable with --run-checks when bats and patched tree are available."
    },
    {
      "id": "full_test_sh",
      "cmd": "./test.sh",
      "enabled": false,
      "category": "correctness",
      "max_points": 5,
      "note": "Disabled for bundle-only grading; base branch may have pre-existing failures."
    }
  ],
  "test_wiring_patterns": [
    "scripts/tests/pr-resolve-all-poll.bats",
    "scripts/checks/.*pr-resolve.*poll"
  ],
  "result_line_pattern": "RESULT=",
  "latency_bands_seconds": [
    {
      "max": 300,
      "points": 10
    },
    {
      "max": 450,
      "points": 8
    },
    {
      "max": 600,
      "points": 6
    },
    {
      "max": 900,
      "points": 4
    },
    {
      "max": 1200,
      "points": 2
    },
    {
      "max": null,
      "points": 0
    }
  ]
}
