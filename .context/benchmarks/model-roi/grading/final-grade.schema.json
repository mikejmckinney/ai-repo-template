{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "benchmark-final-grades.v1",
  "type": "object",
  "required": [
    "schema_version",
    "score_set_id",
    "task_id",
    "rubric_id",
    "grader_id",
    "rows",
    "compiled_at"
  ],
  "properties": {
    "schema_version": { "const": "benchmark-final-grades.v1" },
    "score_set_id": { "type": "string" },
    "task_id": { "type": "string" },
    "rubric_id": { "const": "rubric.v1" },
    "grader_id": { "type": "string" },
    "subjective_aggregation": { "enum": ["single", "median"] },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/finalRow" }
    },
    "compiled_at": { "type": "string" }
  },
  "$defs": {
    "finalRow": {
      "type": "object",
      "required": [
        "eval_candidate_id",
        "complete",
        "objective_total",
        "subjective_total",
        "final_total",
        "categories"
      ],
      "properties": {
        "eval_candidate_id": { "type": "string", "pattern": "^eval-[0-9]{3}$" },
        "complete": { "type": "boolean" },
        "hard_gate_pass": { "type": "boolean" },
        "objective_total": { "type": "integer" },
        "subjective_total": { "type": ["integer", "null"] },
        "final_total": { "type": ["integer", "null"] },
        "categories": {
          "type": "object",
          "required": ["correctness", "quality", "process", "reliability", "latency"],
          "properties": {
            "correctness": { "$ref": "#/$defs/categoryTotal" },
            "quality": { "$ref": "#/$defs/categoryTotal" },
            "process": { "$ref": "#/$defs/categoryTotal" },
            "reliability": { "$ref": "#/$defs/categoryTotal" },
            "latency": { "$ref": "#/$defs/categoryTotal" }
          }
        }
      }
    },
    "categoryTotal": {
      "type": "object",
      "required": ["total", "objective", "subjective"],
      "properties": {
        "total": { "type": "number" },
        "objective": { "type": "number" },
        "subjective": { "type": "number" }
      }
    }
  }
}
