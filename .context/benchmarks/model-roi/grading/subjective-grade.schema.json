{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "benchmark-subjective-grade.v1",
  "type": "object",
  "required": [
    "schema_version",
    "score_set_id",
    "eval_candidate_id",
    "grader_id",
    "grader_prompt_id",
    "rubric_id",
    "categories",
    "subjective_total",
    "citations",
    "graded_at"
  ],
  "properties": {
    "schema_version": { "const": "benchmark-subjective-grade.v1" },
    "score_set_id": { "type": "string", "minLength": 1 },
    "eval_candidate_id": { "type": "string", "pattern": "^eval-[0-9]{3}$" },
    "grader_id": { "type": "string", "minLength": 1 },
    "grader_prompt_id": { "const": "model-roi-grader-v1" },
    "rubric_id": { "const": "rubric.v1" },
    "categories": {
      "type": "object",
      "required": ["correctness", "quality", "process", "reliability"],
      "properties": {
        "correctness": { "$ref": "#/$defs/subjectiveCategory" },
        "quality": { "$ref": "#/$defs/subjectiveCategory" },
        "process": { "$ref": "#/$defs/subjectiveCategory" },
        "reliability": { "$ref": "#/$defs/subjectiveCategory" }
      }
    },
    "subjective_total": { "type": "integer", "minimum": 0, "maximum": 35 },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/citation" }
    },
    "graded_at": { "type": "string" }
  },
  "$defs": {
    "subjectiveCategory": {
      "type": "object",
      "required": ["subjective_points", "max_subjective_points", "rationale"],
      "properties": {
        "subjective_points": { "type": "integer", "minimum": 0 },
        "max_subjective_points": { "type": "integer", "minimum": 0 },
        "rationale": { "type": "string", "minLength": 1 },
        "uncertain": { "type": "boolean" }
      }
    },
    "citation": {
      "type": "object",
      "required": ["bundle_ref", "claim"],
      "properties": {
        "bundle_ref": {
          "type": "string",
          "description": "e.g. candidate.md, diff.patch, objective-grade.json#evidence"
        },
        "claim": { "type": "string", "minLength": 1 }
      }
    }
  }
}
