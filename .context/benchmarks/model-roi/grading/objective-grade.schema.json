{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "benchmark-objective-grade.v1",
  "type": "object",
  "required": [
    "schema_version",
    "score_set_id",
    "eval_candidate_id",
    "task_id",
    "rubric_id",
    "hard_gate_pass",
    "categories",
    "objective_total",
    "evidence",
    "graded_at"
  ],
  "properties": {
    "schema_version": { "const": "benchmark-objective-grade.v1" },
    "score_set_id": { "type": "string", "minLength": 1 },
    "eval_candidate_id": { "type": "string", "pattern": "^eval-[0-9]{3}$" },
    "task_id": { "type": "string", "minLength": 1 },
    "rubric_id": { "enum": ["rubric.v1", "rubric.pipeline.v1"] },
    "hard_gate_pass": { "type": "boolean" },
    "hard_gate_reason": { "type": ["string", "null"] },
    "categories": { "type": "object" },
    "objective_total": { "type": "integer", "minimum": 0, "maximum": 100 },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "graded_at": { "type": "string" }
  },
  "oneOf": [
    {
      "properties": {
        "rubric_id": { "const": "rubric.v1" },
        "categories": {
          "type": "object",
          "required": ["correctness", "quality", "process", "reliability", "latency"],
          "properties": {
            "correctness": { "$ref": "#/$defs/categoryScore" },
            "quality": { "$ref": "#/$defs/categoryScore" },
            "process": { "$ref": "#/$defs/categoryScore" },
            "reliability": { "$ref": "#/$defs/categoryScore" },
            "latency": { "$ref": "#/$defs/categoryScore" }
          }
        },
        "objective_total": { "type": "integer", "minimum": 0, "maximum": 65 }
      }
    },
    {
      "properties": {
        "rubric_id": { "const": "rubric.pipeline.v1" },
        "categories": {
          "type": "object",
          "required": [
            "correctness",
            "quality",
            "process",
            "reliability",
            "coordination",
            "latency"
          ],
          "properties": {
            "correctness": { "$ref": "#/$defs/categoryScore" },
            "quality": { "$ref": "#/$defs/categoryScore" },
            "process": { "$ref": "#/$defs/categoryScore" },
            "reliability": { "$ref": "#/$defs/categoryScore" },
            "coordination": { "$ref": "#/$defs/categoryScore" },
            "latency": { "$ref": "#/$defs/categoryScore" }
          }
        },
        "objective_total": { "type": "integer", "minimum": 0, "maximum": 58 }
      }
    }
  ],
  "$defs": {
    "categoryScore": {
      "type": "object",
      "required": ["objective_points", "max_objective_points"],
      "properties": {
        "objective_points": { "type": "number", "minimum": 0 },
        "max_objective_points": { "type": "number", "minimum": 0 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": ["check_id", "status"],
      "properties": {
        "check_id": { "type": "string" },
        "status": { "enum": ["pass", "fail", "skip", "warn"] },
        "detail": { "type": "string" },
        "points_awarded": { "type": "number" },
        "points_possible": { "type": "number" }
      }
    }
  }
}
