# duo-candidates.tsv.example - copy to duo-candidates.tsv and edit model strings
# to match the installed CLIs. The real duo-candidates.tsv is gitignored so the
# runnable manifest can stay local while blind grading is active.
#
# TSV columns:
#   alias  platform  planner_model  planner_agent  planner_effort  planner_effort_mechanism  implementer_model  implementer_agent  implementer_effort  implementer_effort_mechanism  stage
#
# Stage 1D policy:
# - Planner and implementer are separate headless invocations.
# - Planner writes a plan artifact only; implementer starts from a clean frozen
#   base and consumes that artifact.
# - Total ROI uses planner cost + implementer cost.
# - Auto candidates omit/auto-select the model according to the platform adapter.
#
# Effort mechanism values match candidates.tsv.example:
#   flag   = real CLI flag
#   config = config-file alias
#   prompt = prompt/request/approximation
#   none   = no per-run effort control

# alias	platform	planner_model	planner_agent	planner_effort	planner_effort_mechanism	implementer_model	implementer_agent	implementer_effort	implementer_effort_mechanism	stage
cand-12-duo	claude-code	opus	claude-code-cli	medium	prompt	haiku	claude-code-cli	medium	prompt	1d
cand-14-duo	codex	gpt-5.4	codex-cli	medium	flag	gpt-5.4-mini	codex-cli	medium	flag	1d
cand-21-duo	gemini-cli	auto	gemini-cli	default	none	auto	gemini-cli	default	none	1d
cand-19-duo	copilot	auto	copilot-cli	default	none	auto	copilot-cli	default	none	1d
cand-20-duo	cursor	auto	cursor-cli	default	none	auto	cursor-cli	default	none	1d
