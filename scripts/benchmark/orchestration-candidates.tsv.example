# orchestration-candidates.tsv.example — copy to orchestration-candidates.tsv and edit if needed.
#
# SEALED alias->model MAP for issue #376 pipeline runs.
# TSV columns:
#   alias  platform  model  agent  stage  effort  effort_mechanism
#
# Run with:
#   MANIFEST=orchestration-candidates.tsv
#   PROMPT_FILE=../../.github/prompts/model-roi-orchestration-pipeline-candidate.md
#   BENCHMARK_SUBISSUE=#376
#
# Use ORCHESTRATION_VARIANT=pipeline-existing-overlays for cand-03-pipe.
# Use ORCHESTRATION_VARIANT=pipeline-same-model for the other candidates.

# alias   platform      model              agent           stage  effort   effort_mechanism
cand-03-pipe	copilot	claude-opus-4.8	copilot-cli	1	medium	flag
cand-12-pipe	claude-code	opus	claude-code-cli	1	medium	prompt
cand-05-pipe	claude-code	haiku	claude-code-cli	1	medium	prompt
cand-20-pipe	cursor	auto	cursor-cli	1	default	none
cand-21-pipe	gemini-cli	auto	gemini-cli	1	default	none
